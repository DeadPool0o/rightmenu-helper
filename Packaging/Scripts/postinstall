#!/bin/sh
# Open the installed app in the logged-in user's session, never as root.
# Headless and non-startup-volume installations keep the manual launch instructions.
if [ "${3:-/}" != "/" ]; then
    exit 0
fi

console_user=$(/usr/bin/stat -f '%Su' /dev/console 2>/dev/null) || exit 0
case "$console_user" in
    ''|root|loginwindow|_mbsetupuser) exit 0 ;;
esac
console_uid=$(/usr/bin/id -u "$console_user" 2>/dev/null) || exit 0
case "$console_uid" in
    ''|*[!0-9]*) exit 0 ;;
esac
if [ "$console_uid" -lt 501 ]; then
    exit 0
fi

app='/Applications/右键助手.app'
if [ -d "$app" ]; then
    if ! /bin/launchctl asuser "$console_uid" /usr/bin/sudo -H -u "$console_user" -- /usr/bin/open "$app"; then
        printf '%s\n' '右键助手已安装。请从“应用程序”打开，并按提示启用 Finder 扩展。'
    fi
fi
exit 0
